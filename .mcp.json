{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--headless",
        "--isolated",
        "--viewport-size=1280x900",
        "--console-level=warning",
        "--output-dir=web/.shots/mcp"
      ]
    }
  }
}
